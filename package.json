{
  "name": "claude-code-multi-pc",
  "version": "0.1.4",
  "description": "Run Claude Code across multiple PCs and Claude accounts: one lead Claude hands tasks to worker Claudes on your friends' computers, and every Claude sees what the crew is doing.",
  "type": "module",
  "bin": {
    "coop": "bin/coop.js",
    "claude-code-multi-pc": "bin/coop.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "wrangler.example.toml"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "hub": "node bin/coop.js hub"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.2",
    "zod": "^4.1.0"
  },
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "channels",
    "multi-agent",
    "multi-pc",
    "multi-account",
    "multiple-computers",
    "remote-agents",
    "collaboration",
    "co-op",
    "pair-programming"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plyxen/claude-code-multi-pc.git"
  }
}
